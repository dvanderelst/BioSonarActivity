# Copy to .env for local development. On Railway this is provided automatically
# when you attach a Postgres plugin.
DATABASE_URL=postgresql://user:password@localhost:5432/biologydaylogger

# Optional: default countdown duration in seconds (UI lets students override).
DEFAULT_DURATION_SECONDS=300

# Optional: password for the dashboard's "Erase all data" button. If unset,
# the erase control is hidden entirely. Set this in Railway to enable it.
ERASE_PASSWORD=change-me
